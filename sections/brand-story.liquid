{% comment %}
  Brand Story Section: "Born in Long Island 2017"
{% endcomment %}

<section class="hbk-story" id="HbkStory">
  <div class="hbk-container">
    <div class="hbk-story__grid">
      <!-- Story Narrative Column -->
      <div class="hbk-story__narrative">
        <div class="hbk-section-tag">OUR ORIGINS // LONG ISLAND, NY</div>
        <h2 class="hbk-story__title">MORE THAN A BRAND. IT’S A MOVEMENT.</h2>
        <div class="hbk-story__text">
          <p>
            Founded in <strong>2017</strong> by a group of young visionary entrepreneurs in <strong>Long Island, New York</strong>, Heart Break Kids was born out of a hunger to redefine East Coast street culture.
          </p>
          <p>
            When HBK first started, our passion for creating an authentic movement drove us to host community pop-ups, partner with local creators, and engineer standout apparel anchored by our iconic monster mascot eating a broken heart.
          </p>
          <p>
            Every hoodie, sweatsuit, and tee is crafted with heavyweight fleece, precision embroidery, and distinctive graffiti art that invites you to join the HBK family.
          </p>
        </div>

        <!-- Milestones / Stats -->
        <div class="hbk-story__stats">
          <div class="hbk-stat">
            <span class="hbk-stat__num">2017</span>
            <span class="hbk-stat__label">ESTABLISHED IN NY</span>
          </div>
          <div class="hbk-stat">
            <span class="hbk-stat__num">50K+</span>
            <span class="hbk-stat__label">PIECES SHIPPED</span>
          </div>
          <div class="hbk-stat">
            <span class="hbk-stat__num">100%</span>
            <span class="hbk-stat__label">INDEPENDENT HUSTLE</span>
          </div>
        </div>
      </div>

      <!-- Story Visual Column -->
      <div class="hbk-story__visual">
        <div class="hbk-story__frame">
          <img 
            src="https://heartbreakkidsli.com/cdn/shop/files/SliderP_7c2ce295-02a4-40e9-a12c-270e279dc7da_1400x.jpg" 
            alt="HBK Streetwear Roots" 
            class="hbk-story__img"
            loading="lazy"
          >
          <div class="hbk-story__badge-float">
            <img src="{{ 'hbk-logo.svg' | asset_url }}" alt="HBK" width="48" height="48">
            <div>
              <strong>AUTHENTIC HBK</strong>
              <span>LONG ISLAND ORIGINAL</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}

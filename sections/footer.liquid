{% comment %}
  Footer Section
{% endcomment %}

<footer class="hbk-footer" id="HbkFooter">
  <div class="hbk-container">
    <!-- Top Newsletter Row -->
    <div class="hbk-footer__newsletter-box">
      <div class="hbk-footer__newsletter-info">
        <span class="hbk-tag hbk-tag--lime">VIP ACCESS</span>
        <h3 class="hbk-footer__newsletter-title">UNLOCK 15% OFF YOUR NEXT DROP</h3>
        <p class="hbk-footer__newsletter-sub">Get secret drop dates, early restock alerts, and exclusive private discounts.</p>
      </div>

      <form action="/contact#contact_form" method="post" class="hbk-newsletter-form">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="hbk-newsletter-form__field">
          <input 
            type="email" 
            name="contact[email]" 
            class="hbk-newsletter-input" 
            placeholder="Enter your email address..." 
            required 
            aria-label="Email Address"
          >
          <button type="submit" class="hbk-btn hbk-btn--primary">
            SUBSCRIBE &rarr;
          </button>
        </div>
      </form>
    </div>

    <!-- Main Footer Columns -->
    <div class="hbk-footer__grid">
      <!-- Col 1: Brand Info -->
      <div class="hbk-footer__col hbk-footer__col--brand">
        <div class="hbk-footer__brand-header">
          <img src="{{ 'hbk-logo.svg' | asset_url }}" alt="HBK" width="44" height="44">
          <div>
            <strong>HEART BREAK KIDS</strong>
            <span>LONG ISLAND, NY</span>
          </div>
        </div>
        <p class="hbk-footer__about-text">
          Independent New York streetwear brand founded in 2017. Bold graphics, heavyweight fleece, and iconic monster drip engineered for the streets.
        </p>
        <div class="hbk-footer__socials">
          <a href="https://instagram.com/heartbreakkidsapparel" target="_blank" rel="noopener" aria-label="Instagram" class="hbk-social-link">
            {% render 'icon-instagram' %}
          </a>
          <a href="https://tiktok.com/@heartbreakkidsapparel" target="_blank" rel="noopener" aria-label="TikTok" class="hbk-social-link">
            {% render 'icon-tiktok' %}
          </a>
          <a href="https://facebook.com/heartbreakkidsapparel" target="_blank" rel="noopener" aria-label="Facebook" class="hbk-social-link">
            {% render 'icon-facebook' %}
          </a>
        </div>
      </div>

      <!-- Col 2: Shop Navigation -->
      <div class="hbk-footer__col">
        <h4 class="hbk-footer__heading">SHOP DROPS</h4>
        <ul class="hbk-footer__links">
          <li><a href="/collections/all">All Collections</a></li>
          <li><a href="/collections/hoodies">Hoodies & Sweats</a></li>
          <li><a href="/collections/t-shirts">Graphic Tees</a></li>
          <li><a href="/collections/heartbreakkids">Sweatsuits & Sets</a></li>
          <li><a href="/collections/kids">HBK Kids Club</a></li>
          <li><a href="/collections/hbk-accessories">Accessories & Vault</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Support -->
      <div class="hbk-footer__col">
        <h4 class="hbk-footer__heading">CUSTOMER CARE</h4>
        <ul class="hbk-footer__links">
          <li><a href="/pages/order-tracking">Track My Order</a></li>
          <li><a href="/pages/contact-us">Contact Customer Support</a></li>
          <li><a href="/pages/size-guide">Garment Sizing Guide</a></li>
          <li><a href="/pages/faqs">Frequently Asked Questions</a></li>
          <li><a href="/account">Account Sign In</a></li>
        </ul>
      </div>

      <!-- Col 4: Guarantees & Policies -->
      <div class="hbk-footer__col">
        <h4 class="hbk-footer__heading">PEACE OF MIND</h4>
        <ul class="hbk-footer__links">
          <li><a href="/policies/shipping-policy">Shipping & Delivery Policy</a></li>
          <li><a href="/policies/refund-policy">14-Day Return & Refund Guarantee</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        </ul>
        <div class="hbk-footer__guarantee-badge">
          <span>✓ 100% SECURE SHOP PAY CHECKOUT</span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="hbk-footer__bottom">
      <div class="hbk-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} Heart Break Kids Apparel. All Rights Reserved. Long Island, New York.
      </div>
      <div class="hbk-footer__payments">
        <span class="hbk-pay-badge">Apple Pay</span>
        <span class="hbk-pay-badge">Google Pay</span>
        <span class="hbk-pay-badge">Shop Pay</span>
        <span class="hbk-pay-badge">Visa</span>
        <span class="hbk-pay-badge">Mastercard</span>
        <span class="hbk-pay-badge">Amex</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

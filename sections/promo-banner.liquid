{% comment %}
  Promo Banner Section
  Streetwear high-contrast campaign section for sitewide discount & model showcases.
{% endcomment %}

<section class="hbk-promo" id="HbkPromo">
  <div class="hbk-container">
    <div class="hbk-promo__card">
      <div class="hbk-promo__content">
        <span class="hbk-tag hbk-tag--lime">EXCLUSIVE PROMO</span>
        <h2 class="hbk-promo__title">GET 25% OFF YOUR NEXT DROP</h2>
        <p class="hbk-promo__desc">
          Apply code <strong class="hbk-code-highlight">HBK25</strong> at checkout. Valid across all sweatsuits, hoodies, and signature monster club tees.
        </p>
        <div class="hbk-promo__actions">
          <button type="button" class="hbk-btn hbk-btn--primary js-copy-code" data-code="HBK25">
            <span class="js-copy-text">COPY CODE: HBK25</span>
          </button>
          <a href="/collections/all" class="hbk-btn hbk-btn--glass">SHOP NOW</a>
        </div>
      </div>
      <div class="hbk-promo__image-wrap">
        <img 
          src="https://heartbreakkidsli.com/cdn/shop/files/SliderN_1400x.jpg" 
          alt="HBK Streetwear Models"
          class="hbk-promo__img"
          loading="lazy"
        >
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}

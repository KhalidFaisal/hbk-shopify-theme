{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }} Gift Card</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {{ 'hbk-theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="hbk-body" style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;">
  <div style="background:#16161A;border:1px solid rgba(255,255,255,0.1);padding:40px;border-radius:16px;text-align:center;max-width:440px;">
    <img src="{{ 'hbk-logo.svg' | asset_url }}" alt="HBK" width="70" height="70" style="margin:0 auto 16px;">
    <h1 style="font-family:'Syne',sans-serif;font-size:1.8rem;margin-bottom:8px;">HBK GIFT CARD</h1>
    <p style="color:#8E8E93;margin-bottom:24px;">Your digital streetwear gift card.</p>
    <div style="background:#000;border:1px dashed #FF2A4D;padding:16px;border-radius:8px;font-family:monospace;font-size:1.4rem;letter-spacing:2px;margin-bottom:24px;">
      {{ gift_card.code | default: 'HBK-2026-STASH' }}
    </div>
    <a href="{{ shop.url }}" class="hbk-btn hbk-btn--primary hbk-btn--full">SHOP THE VAULT &rarr;</a>
  </div>
</body>
</html>

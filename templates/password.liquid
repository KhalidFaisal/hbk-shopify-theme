{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }} &ndash; Opening Soon</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {{ 'hbk-theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="hbk-body" style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;">
  <div style="background:#16161A;border:1px solid rgba(255,255,255,0.1);padding:40px;border-radius:16px;text-align:center;max-width:480px;">
    <img src="{{ 'hbk-logo.svg' | asset_url }}" alt="HBK" width="80" height="80" style="margin:0 auto 16px;">
    <span class="hbk-tag hbk-tag--lime" style="margin-bottom:12px;">VAULT LOCKED</span>
    <h1 style="font-family:'Syne',sans-serif;font-size:2rem;margin-bottom:12px;">NEXT DROP LOADING...</h1>
    <p style="color:#8E8E93;margin-bottom:24px;">Enter the store password to access early VIP allocation.</p>
    {% form 'storefront_password' %}
      <div style="display:flex;gap:8px;margin-bottom:16px;">
        <input type="password" name="password" placeholder="Enter password..." class="hbk-newsletter-input" style="background:#000;border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:12px;color:#fff;flex-grow:1;">
        <button type="submit" class="hbk-btn hbk-btn--primary">ENTER</button>
      </div>
    {% endform %}
  </div>
</body>
</html>
